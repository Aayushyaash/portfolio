{
  "name": "portfolio-generator",
  "version": "1.0.0",
  "description": "Static site generator for personal portfolio",
  "main": "scripts/build.js",
  "scripts": {
    "build:css": "npx postcss src/css/tailwind-input.css -o dist/css/tailwind.css",
    "build": "node scripts/build.js && npm run build:css",
    "dev": "npm run build && npx -y serve dist",
    "clean": "node -e \"require('fs-extra').removeSync('dist')\"",
    "lint": "biome lint src/js scripts",
    "lint:fix": "biome lint --write src scripts",
    "format": "biome format --write src scripts",
    "check": "biome check src scripts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Aayush Yash",
  "license": "ISC",
  "dependencies": {
    "dompurify": "^3.3.1",
    "fs-extra": "^11.3.3",
    "glob": "^10.5.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "autoprefixer": "^10.4.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.0",
    "vitest": "^4.0.18"
  }
}
